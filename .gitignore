# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source video masters. The shipped cut in public/video/ is already compressed;
# keep multi-hundred-MB masters out of git history, where they can never be
# removed without a rewrite.
/public/video/masters/

# Not referenced by the page yet. question.png is the reflection-interface
# capture that still shows "QUESTION 1 / 5" on screen; it is kept locally so it
# can be swapped in the moment an approved capture exists, but it should not
# enter git history until then.
/public/graphics/question.png
